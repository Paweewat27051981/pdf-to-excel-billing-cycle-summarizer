// ทดสอบราคาชุดอำเภอ (เช่น "เมือง+น้ำปาด") — เรียก computeTripDocument ตัวจริง
// รัน: npx tsx src/calc.combo.test.mts   (exit 1 ถ้ามีเคสตก)
// ที่มา: บั๊กจริง 19 พ.ย.69 JB0626078701 สาขาพิษณุโลก ได้ 2,184 แทน 2,555 เพราะจุดแรกอยู่คนละจังหวัดกับชุด
import { computeTripDocument } from './calc.js';

const R = (id: string, prov: string, dist: string, price: number) => ({
  id, branchId: 'b', provinceName: prov, provinceShort: '', districtName: dist, destinationName: dist, price,
  priceType: 'flat', productCategory: 'normal', effectiveFrom: '2020-01-01', status: 'active',
}) as any;
const rates = [
  R('ud-m', 'อุตรดิตถ์', 'เมือง', 1855), R('ud-n', 'อุตรดิตถ์', 'น้ำปาด', 2184), R('ud-t', 'อุตรดิตถ์', 'ท่าปลา', 2269),
  R('ud-c', 'อุตรดิตถ์', 'เมือง+น้ำปาด', 2555),
  R('pl-p', 'พิษณุโลก', 'พรหมพิราม', 937), R('pl-m', 'พิษณุโลก', 'เมือง', 800), R('pl-x', 'พิษณุโลก', 'วังทอง', 900),
  R('st-c', 'สุโขทัย', 'เมือง+คีรีมาศ', 1400), R('st-m', 'สุโขทัย', 'เมือง', 1000), R('st-k', 'สุโขทัย', 'คีรีมาศ', 1200),
  R('lp-c', 'ลำปาง', 'เมือง+เมืองปาน', 3000), R('lp-p', 'ลำปาง', 'เมืองปาน', 1500), R('lp-m', 'ลำปาง', 'เมือง', 1100),
  R('lp-j', 'ลำปาง', 'แจ้ห่ม', 1300),
];
const ctx = {
  cycleId: 'c', cycle: { year: 2026, month: 11, half: 'first' }, vehicles: [], rates, rateOverrides: new Map(),
  groups: [], aliases: [], rules: [], manualBoxSenders: [], destOverrides: [], minBoxes: null, fileName: 't',
} as any;
const trip = (stops: [string, string][], headProv = stops[0][0]) => ({
  documentNo: 'T', documentDate: '2026-11-05', plateNo: 'X', provinceRaw: headProv, districtRaw: stops[0][1],
  receipts: stops.map(([p, d], i) => ({
    receiptNo: 'R' + i, receiverName: 'r', senderName: 's', provinceRaw: p, districtRaw: d,
    items: [{ productName: 'สินค้า', quantity: 10, unit: 'กล่อง' }],
  })),
}) as any;

const cases: [string, [string, string][], number, string?][] = [
  // ---- บั๊กที่แก้ (โค้ดเดิมตก) ----
  ['เคสจริง JB0626078701: พรหมพิราม(พล) + น้ำปาด + เมือง(อต) -> พื้นชุด 2555',
    [['พิษณุโลก', 'พรหมพิราม'], ['อุตรดิตถ์', 'น้ำปาด'], ['อุตรดิตถ์', 'เมือง']], 2555],
  ['เมือง(พล) นำหน้า + เมือง+น้ำปาด(อต) -> 2555', [['พิษณุโลก', 'เมือง'], ['อุตรดิตถ์', 'เมือง'], ['อุตรดิตถ์', 'น้ำปาด']], 2555],
  ['ห้ามจับชุดข้ามจังหวัด: น้ำปาด(อต)+เมือง(พล) -> เหมาสูงสุด 2184 (เดิมได้ชุด 2555 = จ่ายเกิน)',
    [['อุตรดิตถ์', 'น้ำปาด'], ['พิษณุโลก', 'เมือง']], 2184],
  // ---- พฤติกรรมเดิมต้องคงอยู่ ----
  ['ตรงชุดพอดี เมือง+น้ำปาด(อต) -> 2555', [['อุตรดิตถ์', 'เมือง'], ['อุตรดิตถ์', 'น้ำปาด']], 2555],
  ['ครบชุด+จุดเพิ่มในจังหวัด -> max(2555, 2269)', [['อุตรดิตถ์', 'เมือง'], ['อุตรดิตถ์', 'น้ำปาด'], ['อุตรดิตถ์', 'ท่าปลา']], 2555],
  ['ชุดถูกกว่าเหมาแยก เมือง+คีรีมาศ(สท) -> 1400 (บังคับเหมาชุด)', [['สุโขทัย', 'เมือง'], ['สุโขทัย', 'คีรีมาศ']], 1400],
  ['ไม่ครบชุด เมือง(พล)+น้ำปาด(อต) -> 2184', [['พิษณุโลก', 'เมือง'], ['อุตรดิตถ์', 'น้ำปาด']], 2184],
  ['ไม่มีชุด พรหมพิราม+วังทอง(พล) -> 937', [['พิษณุโลก', 'พรหมพิราม'], ['พิษณุโลก', 'วังทอง']], 937],
  // ---- ด่านจาก code review ----
  ['จุดไม่มีจังหวัด ใช้จังหวัดหลักของใบ: เมือง(อต)+น้ำปาด(ว่าง) -> 2555', [['อุตรดิตถ์', 'เมือง'], ['', 'น้ำปาด']], 2555],
  ['ทั้งใบไม่มีจังหวัด -> ห้ามจับชุดจังหวัดใดเลย (ไม่เจอราคา = 0)', [['', 'เมือง'], ['', 'น้ำปาด']], 0, ''],
  ['อำเภอเดียวห้ามจับหลายชื่อในชุด: เมืองปาน(ลป)+จุดต่างจังหวัด -> ไม่ยกพื้นชุด เมือง+เมืองปาน 3000',
    [['ลำปาง', 'เมืองปาน'], ['พิษณุโลก', 'วังทอง']], 1500],
  ['จับคู่ 1:1 (Codex P2): เมืองปาน+แจ้ห่ม(ลป) ไม่ได้ไป อ.เมือง -> ไม่ใช่ชุด เมือง+เมืองปาน -> 1500',
    [['ลำปาง', 'เมืองปาน'], ['ลำปาง', 'แจ้ห่ม']], 1500],
  ['จับคู่ 1:1 ยังจับชุดจริงได้: เมือง+เมืองปาน(ลป) -> 3000', [['ลำปาง', 'เมือง'], ['ลำปาง', 'เมืองปาน']], 3000],
];

let pass = 0, fail = 0;
for (const [name, stops, want, head] of cases) {
  const got = computeTripDocument(trip(stops, head ?? stops[0][0]), ctx, () => 'x').tripAmount;
  const ok = Math.abs(got - want) < 0.001;
  console.log(`${ok ? '✓' : '✗ FAIL'} ${name}: ได้ ${got} (คาด ${want})`);
  ok ? pass++ : fail++;
}
console.log(`\nผ่าน ${pass}/${pass + fail}`);
if (fail) process.exit(1);
